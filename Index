<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Memoria Obstétrica</title>
<style>
body{font-family:Arial,sans-serif;background:linear-gradient(135deg,#ffeaf3,#e9f5ff);margin:0;padding:24px;color:#263238}
.wrap{max-width:800px;margin:auto;background:#fff;border-radius:24px;padding:24px;box-shadow:0 10px 35px #0002}
h1{text-align:center;margin:0 0 6px} .sub{text-align:center;color:#667;margin-bottom:18px}
.stats{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:18px}
.badge{background:#f4f7fa;padding:9px 15px;border-radius:999px;font-weight:bold}
.board{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.card{height:125px;border:0;border-radius:16px;background:#7bb7d9;color:white;font-size:38px;cursor:pointer;box-shadow:0 4px 10px #0001;transition:.2s}
.card:hover{transform:translateY(-2px)} .card.open,.card.matched{background:#fff;border:3px solid #7bb7d9;color:#263238}
.card span{visibility:hidden}.card.open span,.card.matched span{visibility:visible}
.card.matched{background:#e8f8ed;border-color:#67b77b}
button#restart{display:block;margin:20px auto 0;padding:11px 20px;border:0;border-radius:12px;background:#4f8db0;color:white;font-weight:bold;cursor:pointer}
#msg{text-align:center;font-weight:bold;min-height:24px;margin-top:14px}
@media(max-width:600px){.board{grid-template-columns:repeat(3,1fr)}.card{height:105px}}
</style>
</head>
<body>
<div class="wrap">
<h1>🧠 Memoria Obstétrica</h1>
<div class="sub">Encuentra las parejas y demuestra cuánto recuerdas.</div>
<div class="stats">
<div class="badge">⭐ Puntos: <span id="score">0</span></div>
<div class="badge">🎯 Parejas: <span id="pairs">0</span>/6</div>
<div class="badge">🔄 Intentos: <span id="tries">0</span></div>
</div>
<div class="board" id="board"></div>
<div id="msg">Busca dos cartas iguales.</div>
<button id="restart">🔄 Nuevo juego</button>
</div>
<script>
const data=[
["👶","Recién nacido"],["👶","Recién nacido"],
["🩺","Estetoscopio"],["🩺","Estetoscopio"],
["💉","Jeringa"],["💉","Jeringa"],
["🧤","Guantes"],["🧤","Guantes"],
["❤️","Frecuencia cardíaca"],["❤️","Frecuencia cardíaca"],
["📋","Historia clínica"],["📋","Historia clínica"]
];
let cards=[],first=null,second=null,lock=false,score=0,pairs=0,tries=0;
const board=document.getElementById("board");
function shuffle(a){return a.sort(()=>Math.random()-.5)}
function start(){
cards=shuffle([...data]); first=second=null;lock=false;score=0;pairs=0;tries=0;
document.getElementById("score").textContent=0;
document.getElementById("pairs").textContent=0;
document.getElementById("tries").textContent=0;
document.getElementById("msg").textContent="Busca dos cartas iguales.";
board.innerHTML="";
cards.forEach((item,i)=>{
 const b=document.createElement("button"); b.className="card";
 b.innerHTML=`<span>${item[0]}</span>`;
 b.title="Carta";
 b.onclick=()=>flip(b,i);
 board.appendChild(b);
});
}
function flip(b,i){
if(lock||b.classList.contains("open")||b.classList.contains("matched"))return;
b.classList.add("open");
if(!first){first={b,i};return}
second={b,i};tries++;document.getElementById("tries").textContent=tries;lock=true;
if(cards[first.i][0]===cards[second.i][0]){
 first.b.classList.add("matched");second.b.classList.add("matched");
pairs++;score+=20;document.getElementById("pairs").textContent=pairs;document.getElementById("score").textContent=score;
document.getElementById("msg").textContent="🎉 ¡Pareja encontrada!";
first=second=null;lock=false;
if(pairs===6){score+=50;document.getElementById("score").textContent=score;document.getElementById("msg").textContent="🏆 ¡Excelente! Completaste la memoria obstétrica."}
}else{
score=Math.max(0,score-2);document.getElementById("score").textContent=score;
document.getElementById("msg").textContent="Casi... intenta recordar dónde estaba.";
setTimeout(()=>{first.b.classList.remove("open");second.b.classList.remove("open");first=second=null;lock=false},800);
}
}
document.getElementById("restart").onclick=start; start();
</script>
</body>
</html>
